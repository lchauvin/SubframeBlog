# Copy to .env.local and fill in. .env.local is gitignored.

# --- Automatic annotation (optional) ----------------------------------------
# API key from your nova.astrometry.net account (Profile -> API key).
# With this set, uploading a master starts a plate solve in the background and
# pre-fills the frame's viewer annotations with the deep-sky objects found.
#
# NOTE: the solve works by uploading a 2048px derivative of the image to
# nova.astrometry.net. Submissions are sent with publicly_visible="n" so they
# are not listed in their public gallery, but the file does leave your machine.
# Leave this unset to disable plate solving entirely — everything else works,
# and annotations can still be entered by hand.
ASTROMETRY_API_KEY=

# Override only if you are pointing at a different astrometry.net instance.
# ASTROMETRY_API_URL=https://nova.astrometry.net/api

# --- Storage (optional) ------------------------------------------------------
# Where the SQLite file and media live. Defaults to ./data
# REQUIRED in production. On Hostinger, use an absolute directory outside the
# replaceable domains/<domain>/nodejs deployment tree.
# ASTROBLOG_DATA_DIR=

# --- First production admin --------------------------------------------------
# Used only when the migrated database contains no admin account. The password
# must be at least 12 characters. Remove ASTROBLOG_ADMIN_PASSWORD from Hostinger
# and redeploy immediately after the first successful login.
# ASTROBLOG_ADMIN_USERNAME=admin
# ASTROBLOG_ADMIN_PASSWORD=

# ASTROBLOG_EXPORT=1 is reserved for the local `npm run export` workflow.
# Do not set it on a Hostinger Node.js web app.

# --- Local WBPP draft importer (optional) -----------------------------------
# Local Ollama model used by `npm run import:wbpp -- <input> [<input>…]` to write the Target
# & processing Body. If unset, the importer picks a model already installed in
# the local Ollama daemon. OLLAMA_HOST defaults to the standard local API.
OLLAMA_MODEL=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_TIMEOUT=120
#
# SIMBAD verifies identifiers, coordinates, object type and distance (in ly) online.
# Wikipedia is used only when SIMBAD and Wikidata have no distance.
# These defaults normally need no changes.
# SIMBAD_TAP_URL=https://simbad.cds.unistra.fr/simbad/sim-tap/sync
# SIMBAD_TIMEOUT=20
# WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
