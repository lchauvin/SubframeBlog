# Copy to .env.local and fill in. .env.local is gitignored.

# --- Automatic annotation (optional) ----------------------------------------
# API key from your nova.astrometry.net account (Profile -> API key).
# With this set, uploading a master starts a plate solve in the background and
# pre-fills the frame's viewer annotations with the deep-sky objects found.
#
# NOTE: the solve works by uploading a 2048px derivative of the image to
# nova.astrometry.net. Submissions are sent with publicly_visible="n" so they
# are not listed in their public gallery, but the file does leave your machine.
# Leave this unset to disable plate solving entirely — everything else works,
# and annotations can still be entered by hand.
ASTROMETRY_API_KEY=

# Override only if you are pointing at a different astrometry.net instance.
# ASTROMETRY_API_URL=https://nova.astrometry.net/api

# --- Storage (optional) ------------------------------------------------------
# Where the SQLite file and media live. Defaults to ./data
# ASTROBLOG_DATA_DIR=
